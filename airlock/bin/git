#!/usr/bin/env python3
"""airlock's guarded git wrapper (prepended to PATH inside sandbox subshells).

Thin launcher: resolves the airlock package relative to this file so the
wrapper works from a source checkout without installation, then delegates
to airlock.git_wrapper.main().
"""
import sys
from pathlib import Path

_PACKAGE_PARENT = Path(__file__).resolve().parents[2]
if str(_PACKAGE_PARENT) not in sys.path:
    sys.path.insert(0, str(_PACKAGE_PARENT))

from airlock.git_wrapper import main

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
